# URL tunnel ke laptop (dari: cloudflared tunnel --url http://127.0.0.1:8000)
# Contoh: BOT_URL=https://acak-acak.trycloudflare.com
# Kosongkan = dashboard tampil data contoh + panduan.
BOT_URL=
# Opsional: key server (kalau diisi, chat bisa dipakai tanpa input key di browser)
# Gratis: Groq -> https://console.groq.com/keys | Gemini -> https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
